# SentinelVault Industrial Environment Configuration
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-64-character-hex-string

# Optional: Custom database path or PostgreSQL connection string
# DATABASE_PATH=/home/site/wwwroot/vault.db
# DATABASE_URL=postgresql://user:password@hostname:5432/sentinelvault

# Set to True in production with SSL / HTTPS
SESSION_COOKIE_SECURE=False

# Port binding (Default 5000 locally, Azure sets $PORT automatically)
PORT=5000
